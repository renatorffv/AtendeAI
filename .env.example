# Banco de dados (Neon Postgres — use a "pooled connection string" em DATABASE_URL
# e a "direct connection string" em DIRECT_URL, necessária para migrations do Prisma)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (NextAuth) — gere com: npx auth secret
AUTH_SECRET="troque-por-um-valor-aleatorio-forte"

# Anthropic (Claude) — chave única da plataforma
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-sonnet-5"

# Google Sheets (conta de serviço)
GOOGLE_SERVICE_ACCOUNT_EMAIL="atendeai-sheets@seu-projeto.iam.gserviceaccount.com"
# Cole a private key do JSON da conta de serviço substituindo quebras de linha por \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Segredo usado pelo Vercel Cron para autorizar a chamada do job de sincronização do catálogo
CRON_SECRET="troque-por-um-valor-aleatorio"

# URL pública desta aplicação (usada para montar a URL de webhook enviada à Evolution API)
APP_URL="https://seu-app.vercel.app"
