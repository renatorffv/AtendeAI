# Copie este arquivo para ".env" nesta mesma pasta antes de subir o docker-compose.

# Senha do Postgres interno da Evolution API (não é o banco da aplicação AtendeAI)
EVOLUTION_POSTGRES_PASSWORD=troque-esta-senha

# Chave de autenticação da Evolution API — gere um valor aleatório forte.
# Esta MESMA chave deve ser cadastrada no campo "Evolution API Key" de cada loja no painel AtendeAI.
EVOLUTION_API_KEY=troque-esta-chave
